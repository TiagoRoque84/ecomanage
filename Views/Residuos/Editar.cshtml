@model EcoManageWeb.Models.Residuo
@{
    ViewData["Title"] = "Editar Resíduo";
}

<div class="d-flex justify-content-between pt-3 pb-2 mb-3 border-bottom">
    <h2>Editar Resíduo</h2>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="mb-3">
                <label>Nome / Descrição</label>
                <input type="text" name="nome" class="form-control" value="@Model.Nome" required />
            </div>
            <div class="mb-3">
                <label>Classe (CETESB)</label>
                <input type="text" name="classe" class="form-control" value="@Model.Classe" required />
            </div>
            <button type="submit" class="btn btn-success">Salvar Alterações</button>
        </form>
    </div>
</div>
