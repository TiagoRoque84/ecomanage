@model IEnumerable<EcoManageWeb.Models.EntradaCarga>
@{
    ViewData["Title"] = "Fechamento Financeiro";
}

<div class="d-flex justify-content-between pt-3 pb-2 mb-3 border-bottom">
    <h2>Fechamento de Faturamento por Cliente</h2>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row gx-3 gy-2 align-items-center">
            <div class="col-sm-4">
                <label class="form-label small text-muted mb-1">Cliente / Gerador</label>
                <select name="clienteId" class="form-select" required>
                    <option value="">Selecione...</option>
                    @foreach(var c in ViewBag.Clientes) {
                        <option value="@c.Id" selected="@(ViewBag.ClienteSelecionado?.Id == c.Id)">@c.RazaoSocial</option>
                    }
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label small text-muted mb-1">Data Inicial</label>
                <input type="date" name="dataInicial" class="form-control" value="@ViewBag.DataInicial">
            </div>
            <div class="col-sm-3">
                <label class="form-label small text-muted mb-1">Data Final</label>
                <input type="date" name="dataFinal" class="form-control" value="@ViewBag.DataFinal">
            </div>
            <div class="col-auto mt-4 pt-1">
                <button type="submit" class="btn btn-success"><i class="fa-solid fa-search"></i> Gerar Relatório</button>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.ClienteSelecionado != null)
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-light shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-muted text-uppercase mb-1">Volume Total Destinado</h6>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalVolumeKg.ToString("N2") <small class="fs-5">kg</small></h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-muted text-uppercase mb-1">Viagens Realizadas</h6>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalViagens</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-white-50 text-uppercase mb-1">Total a Faturar</h6>
                    <h3 class="fw-bold mb-0">R$ @ViewBag.TotalDevido?.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a href="/Relatorios/ImprimirFechamentoPdf?clienteId=@ViewBag.ClienteSelecionado.Id&dataInicial=@ViewBag.DataInicial&dataFinal=@ViewBag.DataFinal" target="_blank" class="btn btn-danger">
            <i class="fa-solid fa-print"></i> Imprimir Fechamento em PDF
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Data Saída</th>
                            <th>Placa</th>
                            <th>Resíduo</th>
                            <th>Peso Líquido</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.Any()) {
                            foreach(var item in Model) {
                                <tr>
                                    <td class="ps-3">@item.DataSaida?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold text-muted">@item.Veiculo.Placa</td>
                                    <td>@item.Contrato.Residuo.Nome</td>
                                    <td class="text-success fw-bold">
                                        @if(item.Status == "Cancelada") {
                                            <span class="text-danger text-decoration-line-through">@item.PesoLiquidoKg.ToString("N2") kg</span>
                                        } else {
                                            @item.PesoLiquidoKg.ToString("N2") <text>kg</text>
                                        }
                                    </td>
                                    <td>
                                        @if(item.Status == "Cancelada") {
                                            <span class="badge bg-danger">Cancelada</span>
                                        } else {
                                            <span class="badge bg-success">Finalizada</span>
                                        }
                                    </td>
                                </tr>
                            }
                        } else {
                            <tr><td colspan="5" class="text-center py-4">Nenhuma viagem encontrada para os filtros aplicados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
