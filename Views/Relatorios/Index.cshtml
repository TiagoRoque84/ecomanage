@model IEnumerable<EcoManageWeb.Models.EntradaCarga>
@{
    ViewData["Title"] = "Relatórios Gerenciais";
}

<div class="d-flex align-items-center mb-3 text-primary">
    <i class="fa-solid fa-table-list fa-lg me-2"></i>
    <h3 class="mb-0 fw-bold">Relatório de Manifestos</h3>
</div>

<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body">
        <form method="get" class="row gx-2 gy-2 align-items-end">
            <div class="col-sm-2">
                <label class="form-label small text-muted mb-1">Data Início</label>
                <input type="date" name="dataInicial" class="form-control form-control-sm" value="@ViewBag.DataInicial">
            </div>
            <div class="col-sm-2">
                <label class="form-label small text-muted mb-1">Data Fim</label>
                <input type="date" name="dataFinal" class="form-control form-control-sm" value="@ViewBag.DataFinal">
            </div>
            <div class="col-sm-2">
                <label class="form-label small text-muted mb-1">Placa</label>
                <input type="text" name="placa" class="form-control form-control-sm" placeholder="ABC-1234">
            </div>
            <div class="col-sm-2">
                <label class="form-label small text-muted mb-1">Cliente</label>
                <input type="text" name="cliente" class="form-control form-control-sm" placeholder="Nome">
            </div>
            <div class="col-sm-2">
                <label class="form-label small text-muted mb-1">Resíduo</label>
                <input type="text" name="residuo" class="form-control form-control-sm" placeholder="Tipo">
            </div>
            <div class="col-sm-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="fa-solid fa-search"></i> Filtrar</button>
                <button type="button" class="btn btn-success btn-sm flex-fill" onclick="alert('Exportação Excel em breve!')"><i class="fa-solid fa-file-excel"></i> Excel</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0" style="font-size: 0.9rem;">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">Manifesto</th>
                    <th>Status</th>
                    <th>Placa</th>
                    <th>Motorista</th>
                    <th>Cliente</th>
                    <th>Entrada</th>
                    <th>Peso Liq.</th>
                    <th>Obs</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
                @if(Model.Any()) {
                    foreach(var item in Model) {
                        <tr>
                            <td class="ps-3 fw-bold">#@(item.Mtr?.NumeroMtr ?? item.Id.ToString())</td>
                            <td>
                                @if(item.Status == "Cancelada") {
                                    <span class="badge bg-danger">CANCELADO</span>
                                } else if(item.Status == "Finalizada") {
                                    <span class="badge bg-success">FECHADO</span>
                                } else {
                                    <span class="badge bg-warning text-dark">ABERTO</span>
                                }
                            </td>
                            <td class="fw-bold">@item.Veiculo.Placa</td>
                            <td>@(item.Motorista?.Nome ?? "-")</td>
                            <td>@item.Contrato.Cliente.RazaoSocial</td>
                            <td>@item.DataEntrada.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="fw-bold">@item.PesoLiquidoKg.ToString("N2") kg</td>
                            <td class="small text-muted" style="max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@(item.MotivoCancelamento ?? item.Observacoes)">
                                @(item.Status == "Cancelada" ? $"Cancelado: {item.MotivoCancelamento}" : item.Observacoes)
                            </td>
                            <td>
                                @if(item.Mtr != null) {
                                    <a href="/Mtr/Pdf/@item.Mtr.Id" target="_blank" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-file-pdf"></i></a>
                                }
                            </td>
                        </tr>
                    }
                } else {
                    <tr><td colspan="9" class="text-center py-4 text-muted">Nenhum dado encontrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
