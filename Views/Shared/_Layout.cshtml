<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoManageWeb</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { min-height: calc(100vh - 56px); background-color: #2D6A4F; }
        .sidebar a { color: rgba(255,255,255,.8); text-decoration: none; padding: 10px 15px; display: block; }
        .sidebar a:hover { color: #fff; background-color: rgba(255,255,255,.1); }
        .navbar-brand { font-weight: bold; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark" style="background-color: #1B4332;">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-leaf text-success"></i> EcoManage Web (C#)</a>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="navbar-nav ms-auto">
                        <span class="nav-item nav-link text-white">@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                        <a class="nav-item nav-link text-warning" asp-controller="Auth" asp-action="Logout">Sair</a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse">
                    <div class="position-sticky pt-3">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Configuracao" asp-action="Index"><i class="fa-solid fa-gear"></i> Configuração do Aterro</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Faturamento" asp-action="Index"><i class="fa-solid fa-file-invoice-dollar"></i> Faturamento / Fechamento</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Relatorios" asp-action="Financeiro"><i class="fa-solid fa-chart-pie"></i> Relatório Financeiro</a>
                            </li>
                            <li class="nav-item mt-3 mb-1 text-white-50 px-3 small text-uppercase font-weight-bold">Operacional</li>
                            <li class="nav-item">
                                <a asp-controller="Entrada" asp-action="Index"><i class="fa-solid fa-truck-ramp-box"></i> Entradas de Carga</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Entrada" asp-action="PesagemInicial"><i class="fa-solid fa-plus"></i> Nova Entrada</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Mtr" asp-action="Index"><i class="fa-solid fa-file-signature"></i> MTRs Digitais</a>
                            </li>
                            <li class="nav-item mt-3 mb-1 text-white-50 px-3 small text-uppercase font-weight-bold">Cadastros</li>
                            <li class="nav-item">
                                <a asp-controller="Usuarios" asp-action="Index"><i class="fa-solid fa-users"></i> Usuários</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Clientes" asp-action="Index"><i class="fa-solid fa-building"></i> Clientes</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Motoristas" asp-action="Index"><i class="fa-solid fa-id-card"></i> Motoristas</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Transportadoras" asp-action="Index"><i class="fa-solid fa-truck-fast"></i> Transportadoras</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Veiculos" asp-action="Index"><i class="fa-solid fa-truck"></i> Veículos</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Residuos" asp-action="Index"><i class="fa-solid fa-trash-can"></i> Resíduos</a>
                            </li>
                        </ul>
                    </div>
                </nav>
                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="col-12 px-md-4 py-4">
                    @RenderBody()
                </main>
            }
        </div>
    </div>

    <!-- VLibras - Acessibilidade (Requisito do Manual PIM III - Etapa 8) -->
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
        $(document).ready(function(){
            var cpfCnpjMaskBehavior = function (val) {
                return val.replace(/\D/g, '').length === 11 ? '000.000.000-009' : '00.000.000/0000-00';
            },
            cpfCnpjOptions = {
                onKeyPress: function(val, e, field, options) {
                    field.mask(cpfCnpjMaskBehavior.apply({}, arguments), options);
                }
            };
            $('.cpfcnpj').mask(cpfCnpjMaskBehavior, cpfCnpjOptions);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
