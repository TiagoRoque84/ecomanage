@model IEnumerable<EcoManageWeb.Models.EntradaCarga>
@{
    ViewData["Title"] = "Gerar Novo Fechamento";
}

<div class="d-flex justify-content-between pt-3 pb-2 mb-3 border-bottom">
    <h2>Gerar Fechamento (Faturamento)</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body">
        <form method="get" class="row gx-3 gy-2 align-items-center">
            <div class="col-sm-4">
                <label class="form-label small text-muted mb-1">Cliente / Gerador</label>
                <select name="clienteId" class="form-select" required>
                    <option value="">Selecione...</option>
                    @foreach(var c in ViewBag.Clientes) {
                        <option value="@c.Id" selected="@(ViewBag.ClienteSelecionado == c.Id)">@c.RazaoSocial</option>
                    }
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label small text-muted mb-1">Data Inicial</label>
                <input type="date" name="dataInicial" class="form-control" value="@ViewBag.DataInicial">
            </div>
            <div class="col-sm-3">
                <label class="form-label small text-muted mb-1">Data Final</label>
                <input type="date" name="dataFinal" class="form-control" value="@ViewBag.DataFinal">
            </div>
            <div class="col-auto mt-4 pt-1">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-search"></i> Buscar Pesagens Livres</button>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.ClienteSelecionado != null)
{
    <form asp-action="Lancar" method="post" target="_blank" onsubmit="setTimeout(function() { window.location.href = '/Faturamento'; }, 1500);">
        <input type="hidden" name="clienteId" value="@ViewBag.ClienteSelecionado" />
        
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <label class="form-label mb-0 fw-bold">Defina o Nome do Período (Aparecerá na Fatura):</label>
                <input type="text" name="periodoStr" class="form-control form-control-sm" placeholder="Ex: Maio/2026" style="width: 200px;" required>
            </div>
            <button type="submit" class="btn btn-success btn-lg"><i class="fa-solid fa-file-excel"></i> Lançar Fatura e Baixar Excel</button>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3"><input type="checkbox" id="selectAll" checked></th>
                                <th>Data Saída</th>
                                <th>Placa</th>
                                <th>Resíduo</th>
                                <th>Peso Líquido (kg)</th>
                                <th>Cobrar Frete?</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.Any()) {
                                foreach(var item in Model) {
                                    <tr>
                                        <td class="ps-3">
                                            <input type="checkbox" name="pesagensSelecionadas" value="@item.Id" class="pesagem-check" checked>
                                        </td>
                                        <td>@item.DataSaida?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="fw-bold">@item.Veiculo.Placa</td>
                                        <td>@item.Contrato.Residuo.Nome</td>
                                        <td class="text-primary fw-bold">@item.PesoLiquidoKg.ToString("N2")</td>
                                        <td>
                                            @if(item.CobrarFrete) { <span class="badge bg-danger">SIM</span> } 
                                            else { <span class="badge bg-secondary">NÃO</span> }
                                        </td>
                                    </tr>
                                }
                            } else {
                                <tr><td colspan="6" class="text-center py-4">Nenhuma pesagem finalizada livre encontrada para este cliente e período.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script>
        document.getElementById('selectAll')?.addEventListener('change', function(e) {
            var checkboxes = document.querySelectorAll('.pesagem-check');
            checkboxes.forEach(function(cb) { cb.checked = e.target.checked; });
        });
    </script>
}
