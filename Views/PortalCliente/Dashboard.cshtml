@model IEnumerable<EcoManageWeb.Models.EntradaCarga>
@{
    ViewData["Title"] = "Meu Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal do Cliente</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; }
        .navbar-custom { background-color: #2D6A4F; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark navbar-custom mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#"><i class="fa-solid fa-leaf text-success bg-white p-1 rounded"></i> Portal do Cliente</a>
            <div class="d-flex text-white align-items-center">
                <span class="me-3"><i class="fa-regular fa-building"></i> @ViewBag.ClienteNome</span>
                <a asp-action="Logout" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-power-off"></i> Sair</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-success shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title fw-bold">Volume Total (Período)</h6>
                    <h3 class="card-text">@ViewBag.TotalVolumeKg.ToString("N2") kg</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title fw-bold">Viagens Recebidas (Período)</h6>
                    <h3 class="card-text">@ViewBag.TotalViagens</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning shadow-sm border-0">
                <div class="card-body text-dark">
                    <h6 class="card-title fw-bold">Total a Pagar (Aberto)</h6>
                    <h3 class="card-text">R$ @ViewBag.ValorAberto?.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title fw-bold">Total Já Pago</h6>
                    <h3 class="card-text">R$ @ViewBag.ValorPago?.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.Fechamentos != null && ((IEnumerable<dynamic>)ViewBag.Fechamentos).Any(f => f.Status == "Aberto"))
    {
        <div class="alert alert-warning shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation fs-4 me-3"></i>
            <div>
                <strong>Atenção!</strong> Você possui faturas em <strong>ABERTO</strong>. Por favor, verifique abaixo.
            </div>
        </div>
    }

    @if (ViewBag.Fechamentos != null && ((IEnumerable<dynamic>)ViewBag.Fechamentos).Any())
    {
        <div class="card shadow-sm border-0 mb-4 border-start border-4 border-success">
            <div class="card-header bg-white pt-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0 text-success"><i class="fa-solid fa-file-invoice-dollar"></i> Faturas Disponíveis</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Nº Fatura</th>
                                <th>Período</th>
                                <th>Data Lançamento</th>
                                <th>Valor Cobrado</th>
                                <th>Status / Vencimento</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var fatura in ViewBag.Fechamentos) {
                                <tr>
                                    <td class="ps-3 fw-bold">#@fatura.Id.ToString("D4")</td>
                                    <td>@fatura.Periodo</td>
                                    <td>@fatura.DataLancamento.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-success">R$ @fatura.ValorTotal.ToString("N2")</td>
                                    <td>
                                        @if(fatura.Status == "Aberto") {
                                            <span class="badge bg-warning text-dark"><i class="fa-regular fa-clock"></i> Aberto</span>
                                            <div class="small text-muted mt-1">Vence: @fatura.DataVencimento?.ToString("dd/MM/yyyy")</div>
                                        } else if (fatura.Status == "Pago") {
                                            <span class="badge bg-success"><i class="fa-solid fa-check"></i> Pago</span>
                                            <div class="small text-muted mt-1">Pago em: @fatura.DataPagamento?.ToString("dd/MM/yyyy")</div>
                                        } else {
                                            <span class="badge bg-secondary">@fatura.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/PortalCliente/BaixarFaturaPdf?id=@fatura.Id" target="_blank" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-file-pdf"></i> Baixar PDF
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form method="get" class="row gx-3 gy-2 align-items-center">
                    <div class="col-sm-4">
                        <label class="form-label small text-muted mb-1">Data Inicial</label>
                        <input type="date" name="dataInicial" class="form-control" value="@ViewBag.DataInicial">
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small text-muted mb-1">Data Final</label>
                        <input type="date" name="dataFinal" class="form-control" value="@ViewBag.DataFinal">
                    </div>
                    <div class="col-auto mt-4 pt-1">
                        <button type="submit" class="btn btn-success"><i class="fa-solid fa-filter"></i> Filtrar Período</button>
                        <a href="/PortalCliente/Dashboard" class="btn btn-outline-secondary">Limpar</a>
                        <a href="/PortalCliente/ImprimirFechamentoPdf?dataInicial=@ViewBag.DataInicial&dataFinal=@ViewBag.DataFinal" target="_blank" class="btn btn-danger"><i class="fa-solid fa-print"></i> Imprimir Fechamento</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white pt-3 pb-2">
                <h5 class="fw-bold mb-0">Histórico de MTRs e Pesagens</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Data Saída</th>
                                <th>Placa</th>
                                <th>Resíduo</th>
                                <th>Peso Líquido</th>
                                <th>MTR Digital</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.Any()) {
                                foreach(var item in Model) {
                                    <tr>
                                        <td class="ps-3">@item.DataSaida?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="fw-bold text-muted">@item.Veiculo.Placa</td>
                                        <td>@item.Contrato.Residuo.Nome</td>
                                        <td class="text-success fw-bold">
                                            @if(item.Status == "Cancelada") {
                                                <span class="text-danger text-decoration-line-through">@item.PesoLiquidoKg.ToString("N2") kg</span>
                                                <span class="badge bg-danger ms-1">Cancelada</span>
                                            } else {
                                                @item.PesoLiquidoKg.ToString("N2") <text>kg</text>
                                            }
                                        </td>
                                        <td>
                                            @if(item.Status == "Cancelada") {
                                                <span class="text-danger small"><i class="fa-solid fa-circle-exclamation"></i> Cancelado: @item.MotivoCancelamento</span>
                                            } else if(item.Mtr != null) {
                                                <a href="/Mtr/Pdf/@item.Mtr.Id" target="_blank" class="btn btn-sm btn-danger"><i class="fa-solid fa-file-pdf"></i> Baixar Manifesto</a>
                                            } else {
                                                <span class="text-muted small">Aguardando emissão</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            } else {
                                <tr><td colspan="5" class="text-center py-4">Nenhuma viagem registrada no período.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
